# ==============================================================================
# 环境变量配置模板 (Environment Variables Template)
# 使用方式：复制本文件为 pjd.env，并根据实际本地数据库环境填入真实密码与连接信息
# 命令示例：cp pjd.env.example pjd.env (Linux/macOS) 或 copy pjd.env.example pjd.env (Windows)
# ==============================================================================

# Postgres 容器初始化
POSTGRES_DB=pgvector_demo
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password_here

# Spring Boot 数据源
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/pgvector_demo?sslmode=disable&stringtype=unspecified&reWriteBatchedInserts=true
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_password_here
