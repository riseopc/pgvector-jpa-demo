# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

# Java source code
[*.java]
indent_style = space
indent_size = 4
max_line_length = 120

# Build and Configuration files
[pom.xml]
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.{json,json5}]
indent_style = space
indent_size = 2

[*.sql]
indent_style = space
indent_size = 4

# Markdown files
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

# Shell scripts
[*.sh]
end_of_line = lf
indent_style = space
indent_size = 2

# Windows batch files
[*.{cmd,bat}]
end_of_line = crlf
indent_style = space
indent_size = 4
